# Demobooru — environment configuration
#
# Copy to `.env` to override any of these defaults:
#   cp env.example .env
# Every variable can also be left unset; the defaults below are demo-safe.

# --- PostgreSQL ---------------------------------------------------------------
# The database is published on host port 5433 (NOT the usual 5432) on purpose:
# the default 5432 is very likely already taken by another local PostgreSQL
# instance. Change DB_HOST_PORT only if 5433 is occupied on your machine.
POSTGRES_USER=demobooru
POSTGRES_PASSWORD=demobooru_demo
POSTGRES_DB=demobooru
DB_HOST_PORT=5433

# --- Backend ------------------------------------------------------------------
BACKEND_HOST_PORT=8001
# Maximum accepted upload size in megabytes.
MAX_UPLOAD_MB=10
# Comma-separated list of browser origins allowed to call the API directly
# (the frontend dev server proxies /api, so this is a convenience for calling
# the API from other tools during development).
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
# Force polling-based file watching in the backend reload watcher. Polling is
# slower but works on every host platform; set to false on Linux hosts where
# inotify events propagate into containers reliably.
WATCHFILES_FORCE_POLLING=true

# --- Frontend -----------------------------------------------------------------
FRONTEND_HOST_PORT=5174
# Where the Vite dev server proxies /api requests to. Inside Docker Compose
# this is the backend service name; if you run Vite directly on the host,
# set it to http://localhost:8001.
API_TARGET=http://backend:8001
# Force polling for the Vite file watcher (same trade-off as above).
VITE_USE_POLLING=true
